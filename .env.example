# The backend is now Supabase Edge Functions, not a local Node process, so
# these aren't read from a .env file — they're set as Supabase secrets:
#
#   supabase secrets set ADMIN_PASSWORD=... BASE_URL=...
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY don't need to be set here either;
# Supabase injects them into every Edge Function automatically.

ADMIN_PASSWORD=
BASE_URL=https://hxh150.github.io/wohnheim-presence
